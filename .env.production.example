# ==============================================================================
# DUBSS-GYM (FitGo!) - Configuración de Variables de Entorno para Producción
# ==============================================================================
# Copia este archivo a `.env` en la raíz antes de ejecutar docker compose:
#   cp .env.production.example .env
# ==============================================================================

# Puerto frontal público del Gateway Nginx (por defecto 80)
PORT=8080

# ------------------------------------------------------------------------------
# 1. Base de Datos PostgreSQL
# ------------------------------------------------------------------------------
DB_DATABASE=gimnasio_db
DB_USERNAME=postgres
DB_PASSWORD=cambiar_este_password_seguro_en_produccion

# ------------------------------------------------------------------------------
# 2. Backend Laravel 11
# ------------------------------------------------------------------------------
APP_NAME="DUBSS-GYM"
APP_ENV=production
APP_DEBUG=false
APP_URL=http://localhost

# Clave criptográfica de Laravel (generar con: php artisan key:generate --show)
APP_KEY=base64:IrirHFvkswKRJSZ+YC5kM8cUs5qqFjlaqwf2i7HXhBs=

# Ejecutar automáticamente migraciones al iniciar el contenedor (true / false)
RUN_MIGRATIONS=true

# Notificaciones y Bot de Telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=FitGoNotificacionesBot

# ------------------------------------------------------------------------------
# 3. Microservicio de Inteligencia Artificial (FastAPI)
# ------------------------------------------------------------------------------
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# ------------------------------------------------------------------------------
# 4. Frontend SPA (React 19 / Vite)
# ------------------------------------------------------------------------------
# Como se usa el Gateway unificado, "/api" enruta automáticamente al backend
VITE_API_URL=/api

